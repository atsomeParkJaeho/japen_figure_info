NODE_ENV=production
PORT=3000

# Render PostgreSQL connection info — set these in the Render dashboard's
# Environment settings, do not commit real values here.
DB_HOST=__RENDER_DB_HOST__
DB_PORT=5432
DB_USER=__RENDER_DB_USER__
DB_PASSWORD=__RENDER_DB_PASSWORD__
DB_NAME=japen_figure_info
DB_SSL=true

JWT_SECRET=__RENDER_JWT_SECRET__
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://__YOUR_FRONTEND_DOMAIN__
